# Database
DATABASE_URL="postgresql://securevault:securevault@localhost:5432/securevault?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# API
PORT=3000
NODE_ENV=development
WEB_ORIGIN="http://localhost:5173"

# JWT (HS256 em desenvolvimento; usar Ed25519 em produção)
JWT_SECRET="change-me-with-a-long-random-secret-at-least-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# MFA TOTP encryption (32 bytes, base64)
TOTP_ENC_KEY=""

# Server OpenPGP key (PEM/ASCII). Em desenvolvimento pode ficar vazio.
SERVER_PRIVATE_KEY=""
SERVER_PUBLIC_KEY=""
SERVER_KEY_FINGERPRINT=""