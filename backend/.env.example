# =============================================================================
# SecureVault Backend — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores antes de iniciar.
# =============================================================================

# --- Ambiente ---
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# --- Banco de dados (PostgreSQL) ---
DATABASE_URL=postgresql://securevault:securevault@localhost:5432/securevault?schema=public

# --- Admin inicial (criado pelo prisma:seed) ---
ADMIN_EMAIL=admin@securevault.local
ADMIN_PASSWORD=ChangeMe123!

# --- JWT (assinatura/verificação de access e refresh tokens) ---
# JWT_SECRET: usado pelo @nestjs/jwt para assinar tokens (mín. 32 caracteres)
JWT_SECRET=change-me-to-a-secret-with-at-least-32-chars!!!
# JWT_PRIVATE_KEY / JWT_PUBLIC_KEY: par de chaves RSA para assinatura assimétrica
# (exigem fail-fast no boot via validateEnv)
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nCOLE_AQUI_SUA_CHAVE_PRIVADA_RSA\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nCOLE_AQUI_SUA_CHAVE_PUBLICA_RSA\n-----END PUBLIC KEY-----
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- TOTP (criptografia de segredos MFA) ---
# TOTP_ENC_KEY: chave base64 de exatamente 32 bytes para cifrar segredos TOTP
# Obrigatória em produção; em desenvolvimento pode ser omitida (usa fallback derivado do JWT_SECRET)
TOTP_ENC_KEY=

# --- Chave do servidor (OpenPGP) ---
SERVER_PUBLIC_KEY=
SERVER_KEY_FINGERPRINT=

# --- Limites e rate limit ---
MAX_ENVELOPE_BYTES=262144
MAX_SECRET_BYTES=1048576
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=5
